# Local SQLite file (default). For Vercel, point this at a durable libSQL database (e.g. Turso):
#   DATABASE_URL=libsql://your-db-name.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/sourcebook.db
DATABASE_AUTH_TOKEN=

# Optional. When set, "Draft facts with Claude" proposes facts from a source's text.
# Every draft must quote the source verbatim and still needs a person to approve it.
ANTHROPIC_API_KEY=

# Optional. Your fund's X API v2 bearer token (developer.x.com), on a plan with recent search.
# Without it, X post links are still read one at a time through X's public embed endpoint.
X_BEARER_TOKEN=
